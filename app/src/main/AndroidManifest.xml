<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Package Visibility Queries (Android 11+, API 30+) -->
    <queries>
        <package android:name="com.truecaller" />
    </queries>

    <!-- Network -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Foreground Service & Power (Direct P2P File Transfer) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Contacts -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Zero-Permission Client-Initiated Reverse SMS uses Android Intent.ACTION_SENDTO (No telephony permissions required) -->

    <!-- Notifications (Android 13+, API 33+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- App Lock biometric unlock (API 28+); legacy alias for API 24-27 -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission
        android:name="android.permission.USE_FINGERPRINT"
        android:maxSdkVersion="27" />

    <!-- Bluetooth Legacy (Android 7.0 - 11, API 24-30) -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission
        android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Bluetooth Modern (Android 12+, API 31+) -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADVERTISE"
        tools:targetApi="s" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_CONNECT"
        tools:targetApi="s" />

    <!-- Nearby Wi-Fi Devices (Android 13+, API 33+) -->
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="tiramisu" />

    <!-- Camera (Fallback for CameraX scanner on de-Googled ROMs) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".NexaApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Nexa_chat">

        <!-- Truecaller 1-Tap SDK OAuth Client ID Binding -->
        <meta-data
            android:name="com.truecaller.android.sdk.ClientId"
            android:value="@string/truecaller_client_id" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Nexa_chat"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Firebase Cloud Messaging Wake-Up Service (Zero-Knowledge Silent Push) -->
        <service
            android:name=".data.remote.push.NexaFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Push Wake-Up Broadcast Receiver (Secured: Internal only) -->
        <receiver
            android:name=".data.remote.push.NexaPushWakeUpReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.nexa.app.PUSH_WAKE_UP" />
            </intent-filter>
        </receiver>

        <!-- Notification Action Broadcast Receiver -->
        <receiver
            android:name=".core.notification.NotificationActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.nexa.app.ACTION_NOTIFICATION_MARK_AS_READ" />
                <action android:name="com.nexa.app.ACTION_NOTIFICATION_DECLINE_CALL" />
                <action android:name="com.nexa.app.ACTION_NOTIFICATION_REPLY" />
            </intent-filter>
        </receiver>

        <!-- System Timezone & Clock Change Receiver for Accurate Backup Rescheduling -->
        <receiver
            android:name=".core.receiver.TimezoneChangeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>

        <!-- Direct P2P File Transfer Foreground Service -->
        <service
            android:name=".data.remote.service.P2PTransferService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".data.service.P2PTransferForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- WorkManager Foreground Service (DataSync) for Resilient Background Backups -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!-- Secure FileProvider for Verified & Released Files (Fail-Closed) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
