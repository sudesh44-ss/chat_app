<?xml version="1.0" encoding="utf-8"?>
<!--
   NEXA Security & Zero-Plaintext Cloud Backup Policy (Android 12+, API 31+)
   Room SQLite databases, private keystores, and shared preferences are strictly excluded
   from standard unencrypted Android OS cloud backups.
   Backup and recovery is performed exclusively via client-side BIP-39 AES-256-GCM vault bundles.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude all local SQLite Room databases and journal files -->
        <exclude domain="database" path="." />
        <!-- Exclude all shared preferences containing auth credentials, tokens, and identity keys -->
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <!-- In-person D2D transfer: exclude local DB to force cryptographic peer re-sync -->
        <exclude domain="database" path="." />
        <!-- Exclude local keystore and encrypted preferences -->
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
