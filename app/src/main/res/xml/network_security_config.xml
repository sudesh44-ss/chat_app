<?xml version="1.0" encoding="utf-8"?>
<!--
   NEXA Production Network Security Configuration
   Cleartext HTTP is disabled globally across all network connections.
   User certificate trust anchors are removed to prevent MITM proxy interception.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
