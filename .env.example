# ==============================================================================
# NEXA ECOSYSTEM — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# This template documents every active, optional, and planned environment variable
# used across the NEXA Go Backend and Android build pipeline.
#
# SECURITY RULES:
# - NEVER commit production secrets, private keys, or passwords to source control.
# - Copy this file to '.env' for local development and replace placeholders with
#   actual development credentials.
# - In production (Render, Supabase, Upstash), configure variables via the platform's
#   secure environment variable management console.
# ==============================================================================

# ==============================================================================
# 1. APPLICATION & SERVER ENVIRONMENT
# ==============================================================================

# Runtime environment ('development', 'test', 'production').
# Controls security strictness, fail-closed guards, mock providers, and logging.
# In 'production', mock SMS providers and unverified fallbacks are strictly rejected.
# Used by: Go Backend (all services)
# Required: Yes in production
# Sensitive: No
# Expected format: development | test | production
APP_ENV=development

# Alternative fallback for APP_ENV if APP_ENV is unset.
# Used by: Go Backend
# Required: No (APP_ENV preferred)
# Sensitive: No
ENV=development

# HTTP & WebSocket port for the Go server to bind to.
# Automatically provided by hosting platforms like Render (e.g., 10000).
# Used by: Go Backend (cmd/server, cmd/relay, cmd/signaling, cmd/handshake)
# Required: Yes (defaults to 8080 if unset)
# Sensitive: No
# Expected format: Integer (e.g. 8080 or 10000)
PORT=8080


# ==============================================================================
# 2. DATABASE PERSISTENCE — POSTGRESQL
# ==============================================================================

# PostgreSQL connection string for account, device, session, and connection storage.
# Supports connection pooling (pgxpool) and automated transactional schema migrations (001-007).
# Used by: Go Backend (internal/database, cmd/server)
# Required: Yes in production (Backend fails closed if database is unavailable in production)
# Sensitive: Yes
# Expected format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL=postgresql://postgres:your_db_password@db.your-supabase-project.supabase.co:5432/postgres?sslmode=require

# Local JSON store fallback path if PostgreSQL is not configured (DEVELOPMENT ONLY).
# Defaults to 'data/identity_store.json' if empty.
# In production, operating on JSON store without PostgreSQL is rejected.
# Used by: Go Backend (internal/identity)
# Required: No (Development fallback only)
# Sensitive: No
# Expected format: File path (e.g., data/identity_store.json or /var/data/identity.json)
IDENTITY_STORE_PATH=data/identity_store.json


# ==============================================================================
# 2b. PHONE PROTECTION AT REST — HMAC + AES-GCM
# ==============================================================================
# Required in production; startup (ValidatePhoneCryptoConfig) fails closed without them.
# In development, deterministic fallback keys are used if both are unset.
# Used by: Go Backend (internal/identity/phonecrypto.go)
# Required: Yes in production
# Sensitive: Yes
# Expected format: 32 bytes encoded as raw, hex, or base64 (distinct values)
PHONE_HMAC_KEY=
PHONE_ENC_KEY=


# ==============================================================================
# 3. EPHEMERAL BUFFER & OFFLINE QUEUE — REDIS
# ==============================================================================

# Standard Redis connection URL (with TLS support via rediss:// scheme).
# Used for 24-hour ephemeral offline queue buffers and single-use challenge nonces.
# Used by: Go Backend (internal/queue, internal/auth)
# Required: Yes in production (Backend rejects volatile in-memory fallback in production)
# Sensitive: Yes
# Expected format: rediss://default:PASSWORD@HOST:PORT or redis://HOST:PORT
REDIS_URL=rediss://default:your_redis_password@your-upstash-instance.upstash.io:6379

# Legacy host:port address for Redis (alternative to REDIS_URL).
# Used by: Go Backend (cmd/server fallback)
# Required: No (REDIS_URL is preferred)
# Sensitive: No
# Expected format: host:port (e.g., localhost:6379)
REDIS_ADDR=localhost:6379

# Legacy password for Redis when REDIS_ADDR is used.
# Used by: Go Backend (cmd/server fallback)
# Required: No (if REDIS_URL is used)
# Sensitive: Yes
# Expected format: Secret string
REDIS_PASSWORD=your_redis_password

# Upstash REST API URL for HTTP-based serverless Redis interaction (Optional).
# Used by: Cloud maintenance / monitoring scripts
# Required: No
# Sensitive: No
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io

# Upstash REST API Token for HTTP-based serverless Redis interaction (Optional).
# Used by: Cloud maintenance / monitoring scripts
# Required: No
# Sensitive: Yes
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token


# ==============================================================================
# 4. GOOGLE OAUTH & CREDENTIAL MANAGER
# ==============================================================================

# Google Web Client ID for OAuth 2.0 ID token verification.
# Server validates RS256 token signatures against Google JWKS (https://www.googleapis.com/oauth2/v3/certs).
# MUST strictly match 'R.string.google_web_client_id' in Android client.
# Used by: Go Backend (internal/auth/google_verifier.go)
# Required: Yes (Backend fails closed with 401 if unset)
# Sensitive: No (Public client identifier)
# Expected format: [PROJECT_NUMBER]-[HASH].apps.googleusercontent.com
GOOGLE_CLIENT_ID=356056510017-grmokt7u1sch6hdk9dbah85k2jqe32v2.apps.googleusercontent.com


# ==============================================================================
# 5. REVERSE SMS & TELECOM INBOUND WEBHOOK
# ==============================================================================

# Telecom carrier receiver phone number for Client-Initiated Reverse SMS verification.
# Android client generates zero-permission SMS composer targeting this number with 'NX-VERIFY <nonce>'.
# Used by: Go Backend (internal/auth/reverse_sms.go)
# Required: Yes in production
# Sensitive: No (Public inbound receiving number)
# Expected format: E.164 phone string (e.g., +919876543210)
INBOUND_SMS_RECEIVER_NUMBER=+919800000000

# Shared secret key for HMAC-SHA256 authentication of inbound telecom gateway webhooks.
# Validates payloads from telecom aggregators (Twilio, Telnyx, MSG91) against replay attacks.
# Used by: Go Backend (internal/auth/webhook_auth.go)
# Required: Yes in production (Inbound SMS webhooks reject unauthenticated requests)
# Sensitive: Yes
# Expected format: 64-character hexadecimal string or high-entropy secret
GATEWAY_WEBHOOK_SECRET=your_gateway_webhook_hmac_secret_key_hex


# ==============================================================================
# 6. TRUSTED PHONE AUTO-VERIFICATION (QA / INTERNAL DEVICES)
# ==============================================================================

# Comma-separated list of pre-authorized phone numbers for automatic verification bypass.
# In 'production', any malformed phone number causes the registry to fail closed (clears allowlist).
# Client cannot self-declare trusted status; check is purely server-side.
# Used by: Go Backend (internal/auth/trusted_phone.go)
# Required: No (defaults to empty allowlist)
# Sensitive: Yes (Restricted internal device numbers)
# Expected format: Comma-separated E.164 phone numbers (e.g., +919876543210,+919876543211)
NEXA_TRUSTED_PHONE_NUMBERS=+919876543210


# ==============================================================================
# 7. BACKGROUND NOTIFICATIONS — FIREBASE CLOUD MESSAGING (FCM)
# ==============================================================================

# Google Cloud Firebase Project ID for privacy-first silent background wake-up pings.
# FCM payloads NEVER contain plaintext messages, sender identities, or cryptographic keys.
# Payload is strictly a generic wake-up signal: { "data": { "type": "WAKE_UP" } }.
# Used by: Go Backend (internal/fcm/fcm_service.go)
# Required: Yes in production (If unset, operates in mock log-only mode)
# Sensitive: No
# Expected format: Firebase project identifier (e.g., nexa-chat-prod)
FCM_PROJECT_ID=nexa-chat-prod

# [FUTURE / PLANNED] Google Service Account JSON credentials for FCM v1 HTTP API OAuth2 token generation.
# Used by: Go Backend (internal/fcm)
# Required: Required when FCM v1 Google OAuth token exchange is fully integrated
# Sensitive: Yes
# Expected format: Single-line JSON string or path to service-account.json
FIREBASE_SERVICE_ACCOUNT_JSON=


# ==============================================================================
# 8. LEGACY OUTBOUND OTP FALLBACK (OPTIONAL / DEPRECATED)
# ==============================================================================

# Cryptographic salt pepper for hashing legacy OTP codes in OtpService.
# Used by: Go Backend (internal/auth/otp_service.go)
# Required: Optional (used only for legacy outbound OTP fallback)
# Sensitive: Yes
# Expected format: 64-character hexadecimal salt string
OTP_SERVER_PEPPER=your_otp_server_salt_pepper_hex

# Development flag to log plaintext OTPs in server console (STRICTLY PROHIBITED IN PRODUCTION).
# In production (APP_ENV=production), this toggle is ignored and mock provider is disabled.
# Used by: Go Backend (internal/auth/sms_provider.go)
# Required: No (Development only)
# Sensitive: Yes (if enabled in non-production)
# Expected format: true | false
DEBUG_SHOW_OTP=false

# MSG91 authentication key for outbound Indian domestic SMS OTP dispatch.
# Used by: Go Backend (internal/auth/sms_provider.go)
# Required: Optional (used only if MSG91 outbound OTP fallback is active)
# Sensitive: Yes
# Expected format: MSG91 API auth key string
MSG91_AUTH_KEY=

# MSG91 DLT-approved template ID for OTP SMS dispatch.
# Used by: Go Backend (internal/auth/sms_provider.go)
# Required: Optional (required alongside MSG91_AUTH_KEY)
# Sensitive: No
# Expected format: Template ID string
MSG91_TEMPLATE_ID=

# Twilio Account SID for outbound international SMS OTP dispatch.
# Used by: Go Backend (internal/auth/sms_provider.go)
# Required: Optional (used only if Twilio outbound OTP fallback is active)
# Sensitive: Yes
# Expected format: ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_ACCOUNT_SID=

# Twilio Auth Token.
# Used by: Go Backend (internal/auth/sms_provider.go)
# Required: Optional (required alongside TWILIO_ACCOUNT_SID)
# Sensitive: Yes
# Expected format: 32-character auth token
TWILIO_AUTH_TOKEN=

# Twilio verified outbound phone number.
# Used by: Go Backend (internal/auth/sms_provider.go)
# Required: Optional
# Sensitive: No
# Expected format: E.164 phone string (e.g., +12025550199)
TWILIO_FROM_NUMBER=
TWILIO_PHONE_NUMBER=


# ==============================================================================
# 9. SUPABASE JWT VERIFICATION (LEGACY / INTEGRATION)
# ==============================================================================

# Supabase JWT Secret for verifying legacy Supabase authentication tokens.
# Used by: Go Backend (internal/auth/supabase_verifier.go)
# Required: No (used only for /api/v1/auth/supabase/verify)
# Sensitive: Yes
# Expected format: JWT secret string
SUPABASE_JWT_SECRET=

# Supabase Project URL.
# Used by: Go Backend (internal/auth/supabase_verifier.go)
# Required: No
# Sensitive: No
# Expected format: https://[PROJECT_ID].supabase.co
SUPABASE_URL=


# ==============================================================================
# 10. ANDROID APPLICATION BUILD & RELEASE SIGNING
# ==============================================================================

# Release keystore store password for signing production APK / AAB bundles.
# Read by Gradle from environment variables or local.properties.
# Used by: Android Gradle Build (app/build.gradle.kts)
# Required: Yes for release builds
# Sensitive: Yes
# Expected format: Keystore password string
RELEASE_STORE_PASSWORD=

# Release key alias inside release.keystore.
# Used by: Android Gradle Build (app/build.gradle.kts)
# Required: Yes for release builds (defaults to 'nexa_key')
# Sensitive: No
RELEASE_KEY_ALIAS=nexa_key

# Release private key password inside release.keystore.
# Used by: Android Gradle Build (app/build.gradle.kts)
# Required: Yes for release builds
# Sensitive: Yes
# Expected format: Key password string
RELEASE_KEY_PASSWORD=
